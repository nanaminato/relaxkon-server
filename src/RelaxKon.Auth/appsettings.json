{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Diagnostics": {
    "EnableSensitiveDataLogging": false
  },
  "AiRouting": {
    "AffinityEnabled": true,
    "AffinityMinutes": 30,
    "FailureThreshold": 3,
    "BreakDurationSeconds": 60
  },
  "Jwt": {
    "Issuer": "turbo-ai-server",
    "Audience": "turbo-ai-client",
    "SecretKey": "",
    "RefreshTokenPepper": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "AuthenticationStateCacheSeconds": 60
  },
  "ConnectionStrings": {
    "ciko": "",
    "Redis": ""
  }
}
