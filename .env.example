# Optional: pin a release tag or digest for the combined GHCR image.
# RELAXKON_IMAGE=ghcr.io/nanaminato/relaxkon-server:latest

# Host port. Keep loopback when using a reverse proxy on the host.
RELAXKON_BIND=127.0.0.1
RELAXKON_PORT=6000

# For MySQL, set Database__Provider=MySql and replace the connection string.
Database__Provider=Sqlite
ConnectionStrings__ciko='Data Source=/data/relaxkon.db'
# ConnectionStrings__Redis='redis.example.com:6379,password=REPLACE_ME'

DataProtection__KeyPath=/data/keys
Jwt__Issuer=relaxkon-server
Jwt__Audience=relaxkon-web
Jwt__SecretKey=
Jwt__RefreshTokenPepper=

# Set to the actual frontend origin when frontend and API use separate origins.
# Cors__AllowedOrigins__0=https://app.example.com

# Enable both switches to allow public registration with email verification.
Registration__Enabled=false
PasswordReset__Enabled=false
PasswordReset__PublicBaseUrl=https://app.example.com
PasswordReset__SmtpHost=smtp.example.com
PasswordReset__SmtpPort=587
PasswordReset__EnableSsl=true
PasswordReset__FromAddress=no-reply@example.com
PasswordReset__SmtpUsername=no-reply@example.com
PasswordReset__SmtpPassword=
