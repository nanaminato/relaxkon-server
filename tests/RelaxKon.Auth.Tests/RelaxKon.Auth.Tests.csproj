<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>RelaxKon.Auth.Tests</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
      <EmbeddedResource Include="../../src/RelaxKon.Auth/Resources/library/mysql-upgrade.sql" LogicalName="LibraryUpgrade.sql" />
      <EmbeddedResource Include="../../src/RelaxKon.Auth/Resources/library/sqlite-upgrade.sql" LogicalName="LibrarySqliteUpgrade.sql" />
      <EmbeddedResource Include="../../src/RelaxKon.Auth/Resources/account/create-admin.sql" LogicalName="CreateAdmin.sql" />
      <EmbeddedResource Include="Fixtures/performance-index-upgrade.sql" LogicalName="PerformanceIndexes.sql" />
      <EmbeddedResource Include="Fixtures/feature-access.sql" LogicalName="FeatureAccess.sql" />
      <EmbeddedResource Include="Fixtures/mysql-feature-concurrency.sql" LogicalName="MySqlFeatureConcurrency.sql" />
      <EmbeddedResource Include="Fixtures/sqlite-feature-concurrency.sql" LogicalName="SqliteFeatureConcurrency.sql" />
      <EmbeddedResource Include="Fixtures/apimart-task-route-upgrade.sql" LogicalName="ApimartTaskRoute.sql" />
      <EmbeddedResource Include="Fixtures/role-system-upgrade.sql" LogicalName="RoleSystem.sql" />
      <EmbeddedResource Include="Fixtures/pre-architecture-e01436d.sql" LogicalName="PreArchitecture.sql" />
      <EmbeddedResource Include="Fixtures/registration-email-verification.sql" LogicalName="RegistrationEmail.sql" />
      <EmbeddedResource Include="Fixtures/model-catalog-refresh.sql" LogicalName="ModelCatalogRefresh.sql" />
      <EmbeddedResource Include="Fixtures/routing-weight-upgrade.sql" LogicalName="RoutingWeight.sql" />
      <EmbeddedResource Include="Fixtures/architecture-upgrade.sql" LogicalName="ArchitectureUpgrade.sql" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageReference Include="NUnit" Version="4.5.1" />
        <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
        <PackageReference Include="NUnit.Analyzers" Version="4.14.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="coverlet.collector" Version="10.0.1">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\RelaxKon.Kit\RelaxKon.Kit.csproj" />
      <ProjectReference Include="..\..\src\RelaxKon.Auth\RelaxKon.Auth.csproj" />
    </ItemGroup>

</Project>
